@model FundPool
@{
    ViewData["Title"] = Model.PoolName;
    var transactions = (List<FundTransaction>)ViewBag.Transactions;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    var returnData = (ReturnViewModel)ViewBag.Return;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Model.PoolName</h2>
        <a asp-action="Index" asp-controller="FundPool" class="btn btn-secondary">
            返回列表
        </a>
    </div>

    @* 資金池資訊卡片 *@
    @* 資金池資訊卡片 *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <p class="mb-0">現金餘額：<span>NT$ @returnData.CashBalance.ToString("N0")</span></p>
                <a asp-action="Index"
                   asp-controller="Validation"
                   asp-route-fundPoolId="@Model.FundPoolId"
                   asp-route-redirectTo="Simulate"
                   class="btn btn-outline-success btn-sm">
                    績效對比
                </a>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <p class="mb-0">持股市值：<span>@(returnData.HasCompletePrices ? $"NT$ {returnData.TotalMarketValue:N0}" : "無法計算")</span></p>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <p class="mb-0">總資產：<span>@(returnData.HasCompletePrices ? $"NT$ {returnData.TotalAssets:N0}" : "無法計算")</span></p>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <p class="mb-0">
                    報酬率：
                    @if (returnData.HasCompletePrices)
                    {
                        <span class="fw-bold @(returnData.ReturnRate >= 0 ? "text-success" : "text-danger")">@(returnData.ReturnRate >= 0 ? "+" : "")@returnData.ReturnRate%</span>
                        <span>（<span class="@(returnData.TotalReturn >= 0 ? "text-success" : "text-danger")">@(returnData.TotalReturn >= 0 ? "+" : "-")NT$ @Math.Abs(returnData.TotalReturn).ToString("N0")</span>）</span>
                    }
                    else
                    {
                        <span class="text-warning">無法計算</span>
                    }
                </p>
            </div>
            <div class="mt-2">
                <p class="mb-0 text-muted small">股價日期：@returnData.PriceDate</p>
            </div>

            @* 持股明細 *@
            @if (returnData.Holdings.Any())
            {
            <div class="mt-3">
                <hr>
                <p class="mb-2 fw-bold">持股明細</p>
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>股票</th>
                            <th>股數</th>
                            <th>今日股價</th>
                            <th>市值</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var holding in returnData.Holdings)
                    {
                        <tr><td>@holding.StockCode</td><td>@holding.Shares 股</td><td>NT$ @holding.TodayPrice.ToString("N2")</td><td>NT$ @holding.MarketValue.ToString("N0")</td></tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (!returnData.HasCompletePrices)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    無法取得 @string.Join("、", returnData.MissingPriceCodes) 的股價。請確認 StockApi 已啟動後重新整理頁面。
                </div>
            }
            }
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>交易紀錄</h4>
        <a asp-action="Create"
           asp-controller="FundTransaction"
           asp-route-id="@Model.FundPoolId"
           class="btn btn-primary">
            新增交易
        </a>
    </div>

    @if (transactions.Any())
    {
        <div class="d-flex flex-column" style="min-height: 600px">
            <div class="flex-grow-1">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>時間</th>
                            <th>類型</th>
                            <th>股票代號</th>
                            <th>每股金額</th>
                            <th>股數</th>
                            <th>金額／總金額</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in transactions)
                        {
                            <tr>
                                <td>@t.TransactionTime.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @switch (t.Type)
                                    {
                                        case TransactionType.入金:
                                        case TransactionType.買入:
                                            <span class="badge bg-success">@t.Type</span>
                                            break;
                                        case TransactionType.出金:
                                        case TransactionType.賣出:
                                            <span class="badge bg-danger">@t.Type</span>
                                            break;
                                    }
                                </td>
                                <td>@(t.StockCode ?? "-")</td>
                                <td>@(t.PricePerShare.HasValue ? $"NT$ {t.PricePerShare:N0}" : "-")</td>
                                <td>@(t.Shares.HasValue? t.Shares.ToString() : "-")</td>
                                <td>
                                    @if (t.Amount.HasValue)
                                    {
                                        @($"NT$ {t.Amount:N0}")
                                    }
                                    else if (t.PricePerShare.HasValue && t.Shares.HasValue)
                                    {
                                        @($"NT$ {(t.PricePerShare * t.Shares):N0}")
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit"
                                       asp-controller="FundTransaction"
                                       asp-route-id="@t.TransactionId"
                                       class="btn btn-sm btn-outline-secondary">
                                        編輯
                                    </a>
                                    <form asp-action="Delete"
                                          asp-controller="FundTransaction"
                                          asp-route-id="@t.TransactionId"
                                          method="post"
                                          style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('確定刪除？')">
                                            刪除
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Detail"
                               asp-controller="FundPool"
                               asp-route-id="@Model.FundPoolId"
                               asp-route-transactionPage="@(currentPage - 1)">
                                &laquo;
                            </a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Detail"
                                   asp-controller="FundPool"
                                   asp-route-id="@Model.FundPoolId"
                                   asp-route-transactionPage="@i">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Detail"
                               asp-controller="FundPool"
                               asp-route-id="@Model.FundPoolId"
                               asp-route-transactionPage="@(currentPage + 1)">
                                &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted mt-4">
            <p>目前沒有交易紀錄，點擊右上角新增吧！</p>
        </div>
    }

</div>

